  "records": [
    {
      "id": "INTENT-FOUNDATION-20260815",
      "kind": "OWNER_INTENT_REF",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Foundation Architecture Audit intent",
      "statement_ru": "Превратить ADWF в доказуемую Engineering Operating System, где решения, требования, capability, work и evidence связаны долговечной проверяемой цепочкой.",
      "source_path": "AUDITS/ADWF_FOUNDATION_AUDIT_2026-08-15.md",
      "source_sha256": "98d6018fac4275ca405567b3c0b7be871b18584362ed5f4b1e1d589ef325a2f0",
      "record_sha256": "dd8fd9fc0462d091a17527d38f370cfb38a7ee796591a3979a199a85d29f14fc"
    },
    {
      "id": "REQ-TRACE-001",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Долговременная трассируемость причин и результата",
      "statement_ru": "ADWF должен хранить machine-verifiable chain Owner Intent → Requirement → Decision → Capability → Work Unit → Evidence, не используя chat или runtime Work Memory как долгосрочный SSOT.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "96d6ea5d9cfdeac382761164dae17c4e68c7b75ebf8cf1534d89bc7b4d35377b"
    },
    {
      "id": "DEC-TRACE-001",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Тонкий typed trace graph поверх существующих SSOT",
      "statement_ru": "Хранить first-class только durable intent/requirement/decision records, а Capability Truth, Roadmap/AIWorkPackage и Evidence Graph связывать typed references без копирования их payload.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "8f8b5835db73dc71e842ad5c5019b3fba3238628cbd74485c114edd3de08346e"
    },
    {
      "id": "REQ-LIFECYCLE-001",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Consumer project должен переживать ADWF",
      "statement_ru": "ADWF обязан отличать свои managed surfaces от shared и consumer-owned файлов; adoption/update/detach не могут молча перезаписывать или удалять неизвестные, изменённые или пользовательские данные.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "4f9bba12660534ce54b61d8a13c166ace1a2d10ab560ab73a0fc655f9f6326c1"
    },
    {
      "id": "DEC-LIFECYCLE-001",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Package inventory остаётся SSOT, consumer ownership задаётся отдельным тонким contract",
      "statement_ru": "Переиспользовать MANIFEST.json/SHA256SUMS.txt как единственный inventory release-файлов и добавить только ownership policy + read-only adoption/snapshot/detach semantics; destructive apply не входит в v1.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "6b71630ceebfb404a9a3b7e2e385a674a4a9e6099b2da4136bfee931f7e813b3"
    },
    {
      "id": "DEC-LIFECYCLE-002",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Adoption выполняется отдельной no-overwrite filesystem transaction до любого destructive detach",
      "statement_ru": "Разрешить explicit transactional adoption только для CREATE_PLANNED/ABSENT package paths, с exact source revision, no-replace atomic create, durable journal/snapshot, idempotent resume и conservative rollback; existing consumer/shared paths не перезаписываются, destructive detach остаётся отдельным будущим решением.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "bef41f2b3e25eeddabe328e0b548b56cd7bdb2759865dee103851706cf3e349f"
    },
    {
      "id": "DEC-LIFECYCLE-003",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Destructive detach разрешён только через provenance-bound quarantine transaction",
      "statement_ru": "Разрешить explicit guarded detach только из durable transaction-bound adoption snapshot и READY detach plan: удалять лишь exact unchanged FRAMEWORK_PRIVATE managed paths через quarantine-before-purge transaction; shared, pre-existing и consumer-owned data сохраняются, drift/ambiguous recovery блокируются fail-closed.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "c61beabbce0b4c2f135752bbfda2fbed79705f174ab9983c7df035a5b4df4ae1"
    },
    {
      "id": "REQ-PACKSDK-001",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Project Pack должен быть формальным безопасным SDK contract",
      "statement_ru": "Любой Project Pack обязан пройти строгую versioned schema/semantic validation до detection/materialization и не может декларацией расширить command, provider, secret, network, monetary или consumer-data authority.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "89f9e149898a6f8551e413320ffa1e4002ef9c000dd73c223bd40ae6380fda3d"
    },
    {
      "id": "DEC-PACKSDK-001",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Pack definition является requirement declaration, а не authority grant",
      "statement_ru": "Ввести ProjectPackDefinition v1 с exact digest, bounded command/detection/preview fields и mandatory FREE_ONLY/secret/network/environment/data declarations; materializer переносит только разрешённую projection, а реальные permissions остаются у существующих ADWF policy/Managed Surface boundaries.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "f21064652a42364530ade11fbec9234052ed12512d40d9082257530824d42e67"
    },
    {
      "id": "REQ-ENVSAFE-001",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Project command safety declaration должна иметь реальный runtime enforcement baseline",
      "statement_ru": "Consumer Project Pack command не должен наследовать secrets или исполняться прямо в canonical checkout; exact pack/config binding, environment minimization, data-write isolation и network enforcement truth должны проверяться fail-closed до/после execution.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "2a4e26d9dc451cf779dbbcc7f71f467cc6cc6375605bc4ae08d190a34238d6b3"
    },
    {
      "id": "DEC-ENVSAFE-001",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Portable baseline использует independent exact Git clone и truthful network non-enforcement",
      "statement_ru": "Выполнять consumer project commands в independent local Git clone exact HEAD/tree с minimal child environment, exact pack digest/safety binding, tracked-mutation/canonical-integrity postconditions и self-sealed runtime evidence; network declaration хранить отдельно от enforcement и не заявлять packet/domain sandbox без provider/OS primitive.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "bf565176beacb15c98b873661b240b8aa53d4ce4a7b9db2294677147e9855156"
    },
    {
      "id": "REQ-LIFECYCLE-005",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Consumer identity должна жить вне immutable framework package surface",
      "statement_ru": "После adoption consumer должен получить bounded project identity и exact Project Pack binding без изменения framework-private config/package integrity и без передачи consumer overlay governance/provider/trust authority.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "588062e43b008ce75243647a33d24f19b1f56669881edc5abe5cf858054c9d25"
    },
    {
      "id": "DEC-LIFECYCLE-005",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Consumer bootstrap использует sealed consumer-owned profile + validated effective config overlay",
      "statement_ru": "Хранить consumer identity и Project Pack projection в .adwf-consumer/profile.json вне MANIFEST/Managed Surface inventory; связывать profile с exact framework config digest и pack digest, разрешать overlay только project/commands/project_packs и сохранять profile при guarded detach.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "d5dd145ba0cec666b0136a18c259273aa2ec55746231e5af20513e18148dcc77"
    },
    {
      "id": "REQ-WEBREF-001",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Стандартный Web consumer должен доказать ADWF lifecycle вне framework self-host",
      "statement_ru": "На отдельном synthetic standard-web consumer необходимо machine-verifiably пройти exact-source transactional adoption, bounded consumer profile и React Project Pack binding, isolated project gates, exact-revision preview и guarded detach с сохранением consumer-owned data, не выдавая reference/CI evidence за real downstream LIVE_VERIFIED.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "0011fb1ca1cce25835b4b35877ab43a6f796ca6d7f5b1deff077268c17cfe3f5"
    },
    {
      "id": "DEC-WEBREF-001",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Web reference conformance агрегирует существующие lifecycle/runtime evidence вместо второго evidence framework",
      "statement_ru": "Использовать существующие Managed Surface journals/snapshot, sealed consumer profile, ProjectExecution evidence и preview attestation; добавить только self-sealed REFERENCE_CONFORMANCE_REPORT, который связывает authoritative refs. Network остаётся declaration-only, SHARED_GUARDED merge не добавляется, а reference re-adoption обязана использовать новый transaction identity, возникающий из distinct post-detach plan; это не считается универсальным upgrade/re-install contract.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "cc5aa430025aebbd4e572611211d0529f45e2a61350d05a0ab3caff7eeab6714"
    },
    {
      "id": "REQ-ASREF-001",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Apps Script/data-centric consumer должен доказать ADWF lifecycle без обязательного Google provider",
      "statement_ru": "На отдельном synthetic Apps Script/data-centric consumer необходимо machine-verifiably пройти exact-source adoption, consumer profile/apps-script Project Pack, local-only isolated gates и guarded detach с сохранением consumer-owned scripts/data, не требуя Google credentials/network/deployment и не выдавая local shim за Google runtime evidence.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "709f2a872e44b72dc7061f007cc37ec1bfe02cfe4811d04564ae59b25e1b01d2"
    },
    {
      "id": "DEC-ASREF-001",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Apps Script reference использует существующий Project Pack SDK и общий conformance report",
      "statement_ru": "Добавить apps-script marker pack с precedence над node, network=NONE и без install/start/preview; representative .gs logic тестировать локально через narrow fake SpreadsheetApp boundary в ProjectExecutionSession. Расширить существующий REFERENCE_CONFORMANCE_REPORT вторым class вместо создания отдельного evidence framework; actual Google runtime/provider остаётся отдельной live boundary.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "49832647c2c995857532ce86723cc0fad6a857ce8ac7652e2fbd404fb8b3b7fa"
    },
    {
      "id": "REQ-UPGRADE-001",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Подключённый consumer должен обновлять ADWF через exact-revision fail-closed planning contract",
      "statement_ru": "Consumer project должен получить deterministic machine-verifiable read-only plan перехода с exact ADWF revision A на B, который обнаруживает drift/contract incompatibility, сохраняет consumer/shared/pre-existing ownership и заранее фиксирует rollback prerequisites без write/apply authority.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "915387fea6db28cdff3e6aed9950ee0b1be8e45e46e05451e3aaba97cf34f295"
    },
    {
      "id": "DEC-UPGRADE-001",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Upgrade planning композирует существующие lifecycle evidence и не вводит mutating executor",
      "statement_ru": "Использовать Managed Surface snapshot/provenance, sealed Consumer Profile, Project Pack digest и optional governed Skill bindings как exact inputs; строить self-sealed compatibility/plan, требовать explicit migration records для изменённых contract identities и оставлять transactional apply/recovery отдельному будущему work unit.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "aaeb1f2cfd3dfa9cbe756b5928344d907d6eafc3225662510862e10ab261063e"
    }
  ],
