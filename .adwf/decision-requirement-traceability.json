  "revision": 5,
  "records": [
    {
      "id": "INTENT-FOUNDATION-20260815",
      "kind": "OWNER_INTENT_REF",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Foundation Architecture Audit intent",
      "statement_ru": "Превратить ADWF в доказуемую Engineering Operating System, где решения, требования, capability, work и evidence связаны долговечной проверяемой цепочкой.",
      "source_path": "AUDITS/ADWF_FOUNDATION_AUDIT_2026-08-15.md",
      "source_sha256": "98d6018fac4275ca405567b3c0b7be871b18584362ed5f4b1e1d589ef325a2f0",
      "record_sha256": "dd8fd9fc0462d091a17527d38f370cfb38a7ee796591a3979a199a85d29f14fc"
    },
    {
      "id": "REQ-TRACE-001",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Долговременная трассируемость причин и результата",
      "statement_ru": "ADWF должен хранить machine-verifiable chain Owner Intent → Requirement → Decision → Capability → Work Unit → Evidence, не используя chat или runtime Work Memory как долгосрочный SSOT.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "96d6ea5d9cfdeac382761164dae17c4e68c7b75ebf8cf1534d89bc7b4d35377b"
    },
    {
      "id": "DEC-TRACE-001",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Тонкий typed trace graph поверх существующих SSOT",
      "statement_ru": "Хранить first-class только durable intent/requirement/decision records, а Capability Truth, Roadmap/AIWorkPackage и Evidence Graph связывать typed references без копирования их payload.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "8f8b5835db73dc71e842ad5c5019b3fba3238628cbd74485c114edd3de08346e"
    },
    {
      "id": "REQ-LIFECYCLE-001",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Consumer project должен переживать ADWF",
      "statement_ru": "ADWF обязан отличать свои managed surfaces от shared и consumer-owned файлов; adoption/update/detach не могут молча перезаписывать или удалять неизвестные, изменённые или пользовательские данные.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "4f9bba12660534ce54b61d8a13c166ace1a2d10ab560ab73a0fc655f9f6326c1"
    },
    {
      "id": "DEC-LIFECYCLE-001",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Package inventory остаётся SSOT, consumer ownership задаётся отдельным тонким contract",
      "statement_ru": "Переиспользовать MANIFEST.json/SHA256SUMS.txt как единственный inventory release-файлов и добавить только ownership policy + read-only adoption/snapshot/detach semantics; destructive apply не входит в v1.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "6b71630ceebfb404a9a3b7e2e385a674a4a9e6099b2da4136bfee931f7e813b3"
    },
    {
      "id": "DEC-LIFECYCLE-002",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Adoption выполняется отдельной no-overwrite filesystem transaction до любого destructive detach",
      "statement_ru": "Разрешить explicit transactional adoption только для CREATE_PLANNED/ABSENT package paths, с exact source revision, no-replace atomic create, durable journal/snapshot, idempotent resume и conservative rollback; existing consumer/shared paths не перезаписываются, destructive detach остаётся отдельным будущим решением.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "bef41f2b3e25eeddabe328e0b548b56cd7bdb2759865dee103851706cf3e349f"
    },
    {
      "id": "DEC-LIFECYCLE-003",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Destructive detach разрешён только через provenance-bound quarantine transaction",
      "statement_ru": "Разрешить explicit guarded detach только из durable transaction-bound adoption snapshot и READY detach plan: удалять лишь exact unchanged FRAMEWORK_PRIVATE managed paths через quarantine-before-purge transaction; shared, pre-existing и consumer-owned data сохраняются, drift/ambiguous recovery блокируются fail-closed.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "c61beabbce0b4c2f135752bbfda2fbed79705f174ab9983c7df035a5b4df4ae1"
    },
    {
      "id": "REQ-PACKSDK-001",
      "kind": "REQUIREMENT",
      "version": 1,
      "status": "ACTIVE",
      "title_ru": "Project Pack должен быть формальным безопасным SDK contract",
      "statement_ru": "Любой Project Pack обязан пройти строгую versioned schema/semantic validation до detection/materialization и не может декларацией расширить command, provider, secret, network, monetary или consumer-data authority.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "89f9e149898a6f8551e413320ffa1e4002ef9c000dd73c223bd40ae6380fda3d"
    },
    {
      "id": "DEC-PACKSDK-001",
      "kind": "DECISION",
      "version": 1,
      "status": "ACCEPTED",
      "title_ru": "Pack definition является requirement declaration, а не authority grant",
      "statement_ru": "Ввести ProjectPackDefinition v1 с exact digest, bounded command/detection/preview fields и mandatory FREE_ONLY/secret/network/environment/data declarations; materializer переносит только разрешённую projection, а реальные permissions остаются у существующих ADWF policy/Managed Surface boundaries.",
      "source_path": null,
      "source_sha256": null,
      "record_sha256": "f21064652a42364530ade11fbec9234052ed12512d40d9082257530824d42e67"
    }
  ],
