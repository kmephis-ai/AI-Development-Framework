        ".adwf/adwf.py"
      ],
      "production_paths": [
        ".adwf/lib/owner_intent_service.py",
        ".adwf/lib/work_memory.py"
      ],
      "verification": [
        ".adwf/tests/test_v16_remediation.py"
      ]
