      "status": "LIVE_NOT_VERIFIED",
      "owner_claim_ru": "Trusted collector формирует per-impact/per-pack метрики и regression budgets, но зелёный статус требует достаточной живой выборки.",
      "entrypoints": [
        ".adwf/scripts/github_metrics_collector.py"
