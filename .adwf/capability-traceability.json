      "status": "IMPLEMENTED",
      "owner_claim_ru": "Многодневный public checkpoint хранит только безопасную проекцию и привязан к защищённому внешнему anchor.",
      "entrypoints": [
        ".adwf/scripts/github_runtime_sync.py"
      ],
      "production_paths": [
        ".adwf/lib/github_runtime_store.py",
