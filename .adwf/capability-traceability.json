      "status": "LIVE_NOT_VERIFIED",
      "owner_claim_ru": "Canonical GitHub rulesets создаются и проверяются через provider readback с no-bypass и source-bound required checks.",
      "entrypoints": [
        ".adwf/scripts/github_bootstrap.py"
