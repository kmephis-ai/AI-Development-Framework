      ],
      "live_boundary": "Не менее требуемого числа живых CI samples; provider queue показывается отдельно."
    },
    {
      "id": "AGENT_RETURN_WAKEUP",
      "status": "OPTIONAL_ADAPTER",
      "owner_claim_ru": "Agent result принимается только через bounded inbox contract и затем возвращается в Runtime Supervisor.",
      "entrypoints": [
        ".adwf/scripts/publish_agent_request.py",
        ".adwf/scripts/consume_agent_result.py"
