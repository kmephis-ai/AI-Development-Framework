{
  "$schema": "./schemas/capability-traceability.schema.json",
  "schema_version": 1,
  "framework_version": "1.6.0",
  "capabilities": [
    {
      "id": "TRUSTED_GATE",
      "status": "IMPLEMENTED",
      "owner_claim_ru": "Доверенный gate не разрешает PR самостоятельно ослабить собственные правила проверки.",
      "entrypoints": [
        ".adwf/scripts/publish_trusted_gate.py"
      ],
      "production_paths": [
        ".adwf/lib/trust_boundary.py",
        ".adwf/lib/github_rulesets.py",
        ".github/workflows/adwf-control.yml"
      ],
      "verification": [
        ".adwf/tests/test_v16_remediation.py"
      ]
    },
    {
      "id": "DURABLE_FULL_LOOP",
      "status": "OPTIONAL_ADAPTER",
      "owner_claim_ru": "Runtime Supervisor исполняет детерминированные фазы, а EXECUTE/RECOVERY ожидают сменный Creative Agent adapter, если он не настроен.",
      "entrypoints": [
        ".adwf/adwf.py",
        ".adwf/scripts/run_active_supervisor.py"
      ],
      "production_paths": [
        ".adwf/lib/runtime_supervisor.py",
        ".adwf/lib/action_executors.py",
        ".adwf/lib/durable_orchestrator.py"
      ],
      "verification": [
        ".adwf/tests/test_v16_remediation.py"
      ],
      "live_boundary": "Полностью unattended генерация кода требует отдельно подключённый разрешённый Creative Agent; отсутствие adapter возвращает WAITING_AGENT, а не ложный PASS."
    },
    {
      "id": "OWNER_WAKEUP_CONTINUE",
      "status": "IMPLEMENTED",
      "owner_claim_ru": "Старт задачи и кнопка ПРОДОЛЖИТЬ связаны с durable run и будят trusted controller.",
      "entrypoints": [
        ".adwf/adwf.py",
        ".adwf/lib/owner_portal.py"
      ],
      "production_paths": [
        ".adwf/lib/owner_intent_service.py",
        ".adwf/lib/owner_authority.py",
        ".adwf/lib/controller_wakeup.py"
      ],
      "verification": [
        ".adwf/tests/test_v16_remediation.py"
      ]
    },
