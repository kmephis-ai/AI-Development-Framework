      "production_paths": [
        ".adwf/lib/github_agent_inbox.py",
        ".github/workflows/adwf-control.yml"
      ],
      "verification": [
        ".adwf/tests/test_v16_remediation.py"
      ],
      "live_boundary": "Конкретный ChatGPT/Codex/Claude adapter остаётся заменяемым и не входит в mandatory FREE_ONLY correctness path."
    },
    {
      "id": "DELIVERY_OBSERVATION",
      "status": "OPTIONAL_ADAPTER",
      "owner_claim_ru": "Delivery contract проверяет exact source/artifact observation; reference adapter не выдаётся за production hosting.",
