{
  "$schema": ".adwf/schemas/project-pack.schema.json",
  "schema_version": 1,
  "role": "PROJECT_PACK_DEFINITION",
  "id": "fastapi",
  "language": "python",
  "detect": {
    "contains": [
      "fastapi"
    ],
    "scan_files": [
      "pyproject.toml",
      "requirements.txt"
    ]
  },
  "commands": {
    "unit": {
      "command": [
        "python",
        "-m",
        "pytest",
        "-q"
      ],
      "phases": [
        "pr",
        "main"
      ]
    },
    "start": {
      "command": [
        "python",
        "-m",
        "uvicorn",
        "app:app",
        "--host",
        "127.0.0.1",
        "--port",
        "8000"
      ],
      "phases": [
        "runtime"
      ]
    },
    "install": {
      "command": [
        "python",
        "-m",
        "pip",
        "install",
        "-r",
        "requirements.txt"
      ],
      "phases": [
        "bootstrap",
        "pr",
        "runtime"
      ],
      "requires_file": "requirements.txt"
    }
  },
  "preview": {
    "default_url": "http://127.0.0.1:8000",
    "health_path": "/docs"
  },
  "safety": {
    "monetary_budget_usd": 0,
    "secrets": "FORBIDDEN",
    "network": "PACKAGE_REGISTRY_AND_LOOPBACK",
    "environment": "PROCESS_MINIMAL",
    "data_access": {
      "read_scope": "PROJECT_TREE",
      "write_scope": "TOOL_OUTPUTS_ONLY"
    }
  }
}
