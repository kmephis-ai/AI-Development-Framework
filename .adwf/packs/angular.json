{
  "id": "angular",
  "language": "javascript",
  "detect": {
    "dependency": "@angular/core"
  },
  "commands": {
    "lint": {
      "command": [
        "npm",
        "run",
        "lint"
      ],
      "requires_script": "lint",
      "phases": [
        "pr"
      ]
    },
    "unit": {
      "command": [
        "npm",
        "test",
        "--",
        "--watch=false"
      ],
      "requires_script": "test",
      "phases": [
        "pr",
        "main"
      ]
    },
    "build": {
      "command": [
        "npm",
        "run",
        "build"
      ],
      "requires_script": "build",
      "phases": [
        "pr",
        "main"
      ]
    },
    "start": {
      "command": [
        "npm",
        "start",
        "--",
        "--host",
        "127.0.0.1",
        "--port",
        "4200"
      ],
      "requires_script": "start",
      "phases": [
        "runtime"
      ]
    },
    "install": {
      "command": [
        "npm",
        "ci"
      ],
      "phases": [
        "bootstrap",
        "pr",
        "runtime"
      ],
      "requires_file": "package-lock.json"
    }
  },
  "preview": {
    "desktop": [
      1440,
      900
    ],
    "mobile": [
      390,
      844
    ],
    "golden_paths": [
      "/"
    ],
    "default_url": "http://127.0.0.1:4200"
  }
}
