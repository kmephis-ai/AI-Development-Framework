{
  "$schema": ".adwf/schemas/project-pack.schema.json",
  "schema_version": 1,
  "role": "PROJECT_PACK_DEFINITION",
  "id": "python",
  "language": "python",
  "detect": {
    "files": [
      "pyproject.toml",
      "requirements.txt"
    ]
  },
  "commands": {
    "unit": {
      "command": [
        "python",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests"
      ],
      "phases": [
        "pr",
        "main"
      ]
    },
    "build": {
      "command": [],
      "phases": [
        "pr"
      ]
    },
    "install": {
      "command": [
        "python",
        "-m",
        "pip",
        "install",
        "-r",
        "requirements.txt"
      ],
      "phases": [
        "bootstrap",
        "pr",
        "runtime"
      ],
      "requires_file": "requirements.txt"
    }
  },
  "preview": {},
  "safety": {
    "monetary_budget_usd": 0,
    "secrets": "FORBIDDEN",
    "network": "PACKAGE_REGISTRY",
    "environment": "PROCESS_MINIMAL",
    "data_access": {
      "read_scope": "PROJECT_TREE",
      "write_scope": "TOOL_OUTPUTS_ONLY"
    }
  }
}
