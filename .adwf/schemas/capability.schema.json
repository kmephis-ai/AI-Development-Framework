{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "title",
    "implementation_status",
    "cost_status",
    "mandatory",
    "requires_paid_ai_api"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "implementation_status": {
      "enum": [
        "NOT_DESIGNED",
        "DESIGNED_ONLY",
        "PARTIAL",
        "IMPLEMENTED",
        "DEPRECATED",
        "BLOCKED"
      ]
    },
    "cost_status": {
      "enum": [
        "FREE_VERIFIED",
        "INCLUDED_QUOTA",
        "CONDITIONAL_FREE",
        "OWNER_PROVIDED",
        "METERED",
        "PAID",
        "UNKNOWN",
        "STALE"
      ]
    },
    "mandatory": {
      "type": "boolean"
    },
    "requires_paid_ai_api": {
      "const": false
    },
    "acceptance_evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
