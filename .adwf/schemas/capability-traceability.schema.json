{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF capability truth model v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "truth_model_version",
    "role",
    "framework_version",
    "capabilities"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schema_version": {
      "const": 2
    },
    "truth_model_version": {
      "const": 2
    },
    "role": {
      "const": "CANONICAL_CAPABILITY_TRUTH"
    },
    "framework_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "execution_mode",
          "owner_claim_ru",
          "entrypoints",
          "production_paths",
          "verification",
          "live_evidence"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Z0-9_-]+$"
          },
          "status": {
            "enum": [
              "NOT_DESIGNED",
              "DESIGNED_ONLY",
              "PARTIAL",
              "IMPLEMENTED",
              "LIVE_NOT_VERIFIED",
              "LIVE_VERIFIED",
              "DEPRECATED",
              "BLOCKED"
            ]
          },
          "execution_mode": {
            "enum": [
              "CORE",
              "OPTIONAL_ADAPTER"
            ]
          },
          "owner_claim_ru": {
            "type": "string",
            "minLength": 3
          },
          "entrypoints": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "production_paths": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "verification": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "live_boundary": {
            "type": "string",
            "minLength": 3
          },
          "live_evidence": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 3,
              "pattern": "^certification:[A-Z0-9_-]+$"
            }
          }
        }
      }
    }
  }
}
