{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF Consumer Installation Record v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema", "schema_version", "role", "framework", "consumer", "adoption",
    "managed_surface", "consumer_profile", "safety", "mutation_authority", "record_sha256"
  ],
  "properties": {
    "$schema": {"const": ".adwf/schemas/consumer-installation-record.schema.json"},
    "schema_version": {"const": 1},
    "role": {"const": "CONSUMER_INSTALLATION_RECORD"},
    "framework": {
      "type": "object", "additionalProperties": false,
      "required": ["source_sha", "source_tree", "manifest_sha256"],
      "properties": {
        "source_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_tree": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "manifest_sha256": {"type": "string", "format": "sha256"}
      }
    },
    "consumer": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "base_sha", "base_tree"],
      "properties": {
        "repository": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"},
        "base_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "base_tree": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "adoption": {
      "type": "object", "additionalProperties": false,
      "required": ["transaction_id", "status", "plan_sha256", "snapshot_sha256"],
      "properties": {
        "transaction_id": {"type": "string", "format": "sha256"},
        "status": {"const": "COMMITTED"},
        "plan_sha256": {"type": "string", "format": "sha256"},
        "snapshot_sha256": {"type": "string", "format": "sha256"}
      }
    },
    "managed_surface": {
      "type": "object", "additionalProperties": false,
      "required": ["source_revision", "source_manifest_sha256", "consumer_root_sha256", "entries"],
      "properties": {
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "source_manifest_sha256": {"type": "string", "format": "sha256"},
        "consumer_root_sha256": {"type": "string", "format": "sha256"},
        "entries": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["path", "ownership", "installed_sha256", "managed_by_adwf"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "ownership": {"enum": ["FRAMEWORK_PRIVATE", "SHARED_GUARDED", "CONSUMER_OWNED"]},
              "installed_sha256": {"type": "string", "format": "sha256"},
              "managed_by_adwf": {"type": "boolean"},
              "preserved_sha256": {"type": "string", "format": "sha256"}
            }
          }
        }
      }
    },
    "consumer_profile": {
      "type": "object", "additionalProperties": false,
      "required": ["required", "profile_sha256", "project_pack_id", "project_pack_digest"],
      "properties": {
        "required": {"const": true},
        "profile_sha256": {"type": "string", "format": "sha256"},
        "project_pack_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$"},
        "project_pack_digest": {"type": "string", "format": "sha256"}
      }
    },
    "safety": {
      "type": "object", "additionalProperties": false,
      "required": ["monetary_budget_usd", "secrets"],
      "properties": {
        "monetary_budget_usd": {"const": 0},
        "secrets": {"const": "FORBIDDEN"}
      }
    },
    "mutation_authority": {"const": "NONE_RECORD_IS_PROOF_ONLY"},
    "record_sha256": {"type": "string", "format": "sha256"}
  }
}
