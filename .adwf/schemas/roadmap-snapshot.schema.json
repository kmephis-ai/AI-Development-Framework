{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "product_health",
    "metrics",
    "issues"
  ],
  "properties": {
    "product_health": {
      "enum": [
        "VERIFIED",
        "DEGRADED",
        "BROKEN",
        "NOT_VERIFIED"
      ]
    },
    "metrics": {
      "type": "object"
    },
    "issues": {
      "type": "array"
    },
    "debt": {
      "type": "object"
    },
    "architecture": {
      "type": "object"
    }
  }
}
