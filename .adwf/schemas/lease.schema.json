{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF v1.6 Writer lease",
  "type": "object",
  "additionalProperties": false,
  "required": ["lease_id", "issue_id", "roadmap_id", "worker_id", "claimed_at", "heartbeat_at", "expires_at", "base_sha", "workspace_id", "workspace_path", "branch", "conflict_domains", "status"],
  "properties": {
    "lease_id": {"type": "string", "minLength": 36, "maxLength": 36},
    "issue_id": {"type": "string", "minLength": 1},
    "roadmap_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$"},
    "worker_id": {"type": "string", "minLength": 1},
    "claimed_at": {"type": "string", "format": "date-time"},
    "heartbeat_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "base_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "workspace_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,96}$"},
    "workspace_path": {"type": "string", "pattern": "^\\.adwf-runtime/workspaces/[a-z0-9][a-z0-9-]{2,96}$"},
    "branch": {"type": "string", "pattern": "^adwf/[a-z0-9][a-z0-9-]{2,96}$"},
    "conflict_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "status": {"enum": ["ACTIVE", "RELEASED", "EXPIRED"]}
  }
}
