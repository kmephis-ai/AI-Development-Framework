{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF v1.6 work item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "roadmap_id", "number", "title", "state", "priority", "risk", "type", "goal", "acceptance_criteria", "verification_plan", "conflict_domains", "dependencies", "dependencies_resolved", "human_required", "autonomy_allowed", "product_impact", "roadmap_order"],
  "properties": {
    "id": {"type": "string", "minLength": 3},
    "roadmap_id": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$"},
    "number": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 5},
    "state": {"enum": ["BACKLOG", "SPECIFIED", "READY", "CLAIMED", "IN_PROGRESS", "REVIEW", "VERIFICATION", "DONE", "BLOCKED", "HOLD", "HUMAN_REQUIRED", "RECOVERY", "CANCELLED"]},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "risk": {"enum": ["R0", "R1", "R2", "R3", "R4"]},
    "type": {"enum": ["feature", "bug", "recovery", "verification", "governance", "docs", "migration"]},
    "goal": {"type": "string", "minLength": 10},
    "independent_goals": {"type": "integer", "minimum": 1},
    "acceptance_criteria": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "verification_plan": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 3}},
    "conflict_domains": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "dependencies": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "dependencies_resolved": {"type": "boolean"},
    "human_required": {"type": "boolean"},
    "autonomy_allowed": {"type": "boolean"},
    "product_impact": {"type": "boolean"},
    "roadmap_order": {"type": "integer", "minimum": 0},
    "critical_path_score": {"type": "integer", "minimum": 0},
    "ready_since": {"type": ["string", "null"], "format": "date-time"},
    "writer_id": {"type": ["string", "null"]},
    "lease_id": {"type": ["string", "null"]}
  }
}
