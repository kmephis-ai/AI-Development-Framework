{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF Managed Surface Detach Transaction v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "role",
    "transaction_id",
    "status",
    "adoption_transaction_id",
    "source_revision",
    "source_manifest_sha256",
    "snapshot_sha256",
    "plan_sha256",
    "consumer_root_sha256",
    "attempts",
    "entries",
    "provenance_dirs",
    "removed_dirs",
    "last_error",
    "journal_sha256"
  ],
  "properties": {
    "$schema": {
      "const": ".adwf/schemas/managed-surface-detach-transaction.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "role": {
      "const": "MANAGED_SURFACE_DETACH_TRANSACTION"
    },
    "transaction_id": {
      "type": "string",
      "format": "sha256"
    },
    "status": {
      "enum": [
        "PLANNED",
        "DETACHING",
        "RECOVERY_REQUIRED",
        "RECOVERY_BLOCKED",
        "COMMITTED",
        "ROLLED_BACK"
      ]
    },
    "adoption_transaction_id": {
      "type": "string",
      "format": "sha256"
    },
    "source_revision": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "source_manifest_sha256": {
      "type": "string",
      "format": "sha256"
    },
    "snapshot_sha256": {
      "type": "string",
      "format": "sha256"
    },
    "plan_sha256": {
      "type": "string",
      "format": "sha256"
    },
    "consumer_root_sha256": {
      "type": "string",
      "format": "sha256"
    },
    "attempts": {
      "type": "integer",
      "minimum": 0
    },
    "entries": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "installed_sha256",
          "preserved_sha256",
          "ownership",
          "managed_by_adwf",
          "planned_action",
          "state",
          "quarantine_path"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "installed_sha256": {
            "type": "string",
            "format": "sha256"
          },
          "ownership": {
            "enum": [
              "FRAMEWORK_PRIVATE",
              "SHARED_GUARDED",
              "CONSUMER_OWNED"
            ]
          },
          "managed_by_adwf": {
            "type": "boolean"
          },
          "planned_action": {
            "enum": [
              "PRESERVE_PREEXISTING",
              "PRESERVE_SHARED",
              "PRESERVE_CONSUMER",
              "ALREADY_ABSENT",
              "REMOVE_ELIGIBLE"
            ]
          },
          "state": {
            "enum": [
              "PENDING",
              "PRESERVED",
              "ALREADY_ABSENT",
              "QUARANTINE_PLANNED",
              "QUARANTINED",
              "VERIFIED_ABSENT",
              "PURGED",
              "RESTORED",
              "RECOVERY_BLOCKED"
            ]
          },
          "quarantine_path": {
            "type": [
              "string",
              "null"
            ]
          },
          "preserved_sha256": {
            "type": [
              "string",
              "null"
            ],
            "format": "sha256"
          }
        }
      }
    },
    "provenance_dirs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "removed_dirs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "last_error": {
      "type": [
        "string",
        "null"
      ]
    },
    "journal_sha256": {
      "type": "string",
      "format": "sha256"
    }
  }
}
