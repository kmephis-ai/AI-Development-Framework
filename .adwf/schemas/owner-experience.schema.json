{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF Owner Experience",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "product_brief", "current_preview", "acceptance", "release_summary_ru", "release_facts"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "product_brief": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "brief_id", "goal_ru", "value_ru", "outcome_ru", "acceptance_criteria_ru", "visual_expectation_ru", "constraints_ru", "owner_request_original", "created_at", "redaction"],
      "properties": {
        "schema_version": {"const": 1},
        "brief_id": {"type": "string", "pattern": "^BRIEF-[0-9a-f]{16}$"},
        "goal_ru": {"type": "string", "minLength": 10},
        "value_ru": {"type": "string", "minLength": 10},
        "outcome_ru": {"type": "string", "minLength": 10},
        "acceptance_criteria_ru": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 5}},
        "visual_expectation_ru": {"type": "string", "minLength": 5},
        "constraints_ru": {"type": "array", "items": {"type": "string"}},
        "owner_request_original": {"type": "string", "minLength": 5},
        "created_at": {"type": "string", "format": "date-time"},
        "redaction": {"type": "object", "required": ["status", "findings_count"], "properties": {"status": {"const": "SANITIZED"}, "findings_count": {"type": "integer", "minimum": 0}}}
      }
    },
    "current_preview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "head_sha", "preview_digest", "url", "screenshots", "created_at", "valid_until"],
      "properties": {
        "status": {"enum": ["READY", "FAILED", "STALE", "NOT_VERIFIED"]},
        "head_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "preview_digest": {"type": "string", "format": "sha256"},
        "url": {"type": ["string", "null"]},
        "screenshots": {"type": "array", "items": {"type": "object"}},
        "created_at": {"type": "string", "format": "date-time"},
        "valid_until": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "brief_id", "head_sha", "preview_digest", "decided_at", "decided_by", "note_ru", "stale_reason"],
      "properties": {
        "status": {"enum": ["PENDING", "ACCEPTED", "CHANGES_REQUESTED", "DEFERRED", "STALE", "NOT_REQUIRED"]},
        "brief_id": {"type": ["string", "null"]},
        "head_sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "preview_digest": {"type": ["string", "null"], "format": "sha256"},
        "decided_at": {"type": ["string", "null"], "format": "date-time"},
        "decided_by": {"type": ["string", "null"]},
        "note_ru": {"type": "string"},
        "stale_reason": {"type": ["string", "null"]}
      }
    },
    "release_summary_ru": {"type": "string", "minLength": 10},
    "release_facts": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["summary_ru", "verification_ru", "value_ru"], "properties": {"summary_ru": {"type": "string", "minLength": 5}, "verification_ru": {"type": "string", "minLength": 5}, "value_ru": {"type": "string"}}}}
  }
}
