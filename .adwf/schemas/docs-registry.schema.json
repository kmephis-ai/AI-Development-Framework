{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF documentation freshness registry",
  "type": "object", "additionalProperties": false,
  "required": ["version", "documents"],
  "properties": {
    "version": {"type": "string", "minLength": 3},
    "documents": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "watched", "mode", "source_digest", "reviewed_at", "valid_until"],
      "properties": {
        "path": {"type": "string", "minLength": 3}, "watched": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "mode": {"type": "string", "minLength": 3}, "source_digest": {"type": "string", "format": "sha256"},
        "reviewed_at": {"type": "string", "format": "date-time"}, "valid_until": {"type": "string", "format": "date-time"}
      }
    }}
  }
}
