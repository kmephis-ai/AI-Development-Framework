{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Normalized CI run samples",
  "type": "object", "additionalProperties": false,
  "required": ["observed_at", "runs"],
  "properties": {
    "observed_at": {"type": "string", "format": "date-time"},
    "runs": {"type": "array", "minItems": 1, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "queued_at", "started_at", "completed_at", "conclusion", "first_failure_at", "flaky"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "queued_at": {"type": "string", "format": "date-time"},
        "started_at": {"type": "string", "format": "date-time"}, "completed_at": {"type": "string", "format": "date-time"},
        "conclusion": {"enum": ["PASS", "FAIL", "CANCELLED"]},
        "first_failure_at": {"type": ["string", "null"], "format": "date-time"}, "flaky": {"type": "boolean"}
      }
    }}
  }
}
