{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adwf.local/schemas/session-continuity-checkpoint.schema.json",
  "title": "ADWF SessionContinuityCheckpoint",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "checkpoint_id",
    "checkpoint_revision",
    "project_identity",
    "work_identity",
    "lease_identity",
    "conflict_domains",
    "observed_provider_state",
    "last_verified_transition",
    "evidence_refs",
    "boundary_type",
    "pending_external",
    "next_permitted_action",
    "safe_handover_summary",
    "continuation_capability",
    "created_at",
    "updated_at",
    "checkpoint_digest"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "checkpoint_id": {"type": "string", "pattern": "^[A-Za-z0-9._:-]{8,128}$"},
    "checkpoint_revision": {"type": "integer", "minimum": 0},
    "project_identity": {"type": "string", "minLength": 1, "maxLength": 200},
    "work_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["roadmap_id", "issue_id"],
      "properties": {
        "roadmap_id": {"type": "string", "minLength": 1, "maxLength": 100},
        "issue_id": {"type": ["string", "null"], "maxLength": 40},
        "ai_work_package_digest": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{64})?$"}
      }
    },
    "lease_identity": {"type": ["string", "null"], "maxLength": 160},
    "conflict_domains": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 200},
      "uniqueItems": true,
      "maxItems": 32
    },
    "observed_provider_state": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_sha", "pr_number", "head_sha", "branch"],
      "properties": {
        "main_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "pr_number": {"type": ["integer", "null"], "minimum": 1},
        "head_sha": {"type": ["string", "null"], "pattern": "^(?:[0-9a-f]{40})?$"},
        "branch": {"type": ["string", "null"], "maxLength": 240}
      }
    },
    "last_verified_transition": {"type": "string", "minLength": 1, "maxLength": 240},
    "evidence_refs": {
      "type": "array",
      "items": {"type": "string", "minLength": 1, "maxLength": 500},
      "maxItems": 64
    },
    "boundary_type": {
      "enum": [
        "HUMAN_REQUIRED",
        "OWNER_ATTESTATION_REQUIRED",
        "UAT_REQUIRED",
        "SECURITY_BOUNDARY",
        "DESTRUCTIVE_BOUNDARY",
        "SECRETS_BOUNDARY",
        "CAPABILITY_UNAVAILABLE",
        "EXTERNAL_WAIT",
        "AUTHORITY_EXHAUSTED",
        "ROADMAP_END",
        "EXECUTOR_LIMIT"
      ]
    },
    "pending_external": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "object_ref", "status"],
      "properties": {
        "provider": {"type": ["string", "null"], "maxLength": 100},
        "object_ref": {"type": ["string", "null"], "maxLength": 500},
        "status": {"type": ["string", "null"], "maxLength": 100}
      }
    },
    "next_permitted_action": {"type": "string", "minLength": 1, "maxLength": 500},
    "safe_handover_summary": {"type": "string", "minLength": 1, "maxLength": 2000},
    "continuation_capability": {"enum": ["GENERIC_PROVIDER_RECONCILE", "PRIVATE_SESSION_ACCELERATOR_AVAILABLE"]},
    "created_at": {"type": "string", "format": "date-time"},
    "updated_at": {"type": "string", "format": "date-time"},
    "checkpoint_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
