{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "$schema",
    "schema_version",
    "adapter_id",
    "adapter_version",
    "adapter_kind",
    "invocation_mode",
    "qualification_profile_id",
    "qualification_profile_version",
    "qualification_profile_digest",
    "adapter_digest",
    "status",
    "supported_phases",
    "monetary_budget_usd",
    "executor_auth",
    "network",
    "secrets",
    "filesystem",
    "exact_package_binding",
    "allowed_write_surface_enforced",
    "forbidden_write_surface_rejected",
    "changed_paths_verified",
    "result_contract_verified",
    "secret_environment_filtered",
    "stale_package_rejected",
    "timeout_fail_closed",
    "nonzero_exit_fail_closed",
    "missing_result_fail_closed",
    "low_trust_result",
    "real_external_agent_verified",
    "report_sha256"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "const": ".adwf/schemas/creative-agent-qualification-report.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "adapter_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "adapter_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "adapter_kind": {
      "enum": [
        "REFERENCE_DETERMINISTIC",
        "EXTERNAL_COMMAND"
      ]
    },
    "invocation_mode": {
      "const": "COMMAND"
    },
    "qualification_profile_id": {
      "const": "CREATIVE_AGENT_COMMAND_V2"
    },
    "qualification_profile_version": {
      "const": 2
    },
    "qualification_profile_digest": {
      "type": "string",
      "format": "sha256"
    },
    "adapter_digest": {
      "type": "string",
      "format": "sha256"
    },
    "status": {
      "const": "PASS"
    },
    "supported_phases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "EXECUTE",
          "RECOVERY"
        ]
      }
    },
    "monetary_budget_usd": {
      "const": 0
    },
    "executor_auth": {
      "enum": [
        "NONE",
        "PROVIDER_MANAGED_SESSION"
      ]
    },
    "network": {
      "enum": [
        "NONE",
        "DECLARED_EXTERNAL"
      ]
    },
    "secrets": {
      "const": "FORBIDDEN"
    },
    "filesystem": {
      "const": "PACKAGE_SCOPED"
    },
    "exact_package_binding": {
      "const": true
    },
    "allowed_write_surface_enforced": {
      "const": true
    },
    "forbidden_write_surface_rejected": {
      "const": true
    },
    "changed_paths_verified": {
      "const": true
    },
    "result_contract_verified": {
      "const": true
    },
    "secret_environment_filtered": {
      "const": true
    },
    "stale_package_rejected": {
      "const": true
    },
    "timeout_fail_closed": {
      "const": true
    },
    "nonzero_exit_fail_closed": {
      "const": true
    },
    "missing_result_fail_closed": {
      "const": true
    },
    "low_trust_result": {
      "const": true
    },
    "real_external_agent_verified": {
      "const": false
    },
    "report_sha256": {
      "type": "string",
      "format": "sha256"
    }
  }
}
