{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF capability live evidence certification registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "role",
    "certifications",
    "registry_sha256"
  ],
  "properties": {
    "$schema": {
      "const": ".adwf/schemas/capability-live-evidence-certification.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "role": {
      "const": "CANONICAL_CAPABILITY_LIVE_EVIDENCE_CERTIFICATIONS"
    },
    "certifications": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "evidence_class",
          "capability_ids",
          "subject",
          "provider",
          "report_sha256",
          "consumer",
          "framework",
          "transitions",
          "external_source_unchanged",
          "write_back_performed",
          "certification_sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^CERT-[A-Z0-9_-]+$"
          },
          "evidence_class": {
            "enum": [
              "REAL_EXTERNAL_CONSUMER_UPGRADE"
            ]
          },
          "capability_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^[A-Z0-9_-]+$"
            }
          },
          "subject": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "sha",
              "tree"
            ],
            "properties": {
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "tree": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "provider": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "provider",
              "repository",
              "workflow_run_id",
              "workflow_name",
              "workflow_run_head_sha",
              "check_run_id",
              "check_name",
              "check_app_id",
              "check_app_slug"
            ],
            "properties": {
              "provider": {
                "const": "github"
              },
              "repository": {
                "type": "string",
                "minLength": 3
              },
              "workflow_run_id": {
                "type": "integer",
                "minimum": 1
              },
              "workflow_name": {
                "type": "string",
                "minLength": 3
              },
              "workflow_run_head_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "check_run_id": {
                "type": "integer",
                "minimum": 1
              },
              "check_name": {
                "type": "string",
                "minLength": 3
              },
              "check_app_id": {
                "type": "integer",
                "minimum": 1
              },
              "check_app_slug": {
                "type": "string",
                "minLength": 3
              }
            }
          },
          "report_sha256": {
            "type": "string",
            "format": "sha256"
          },
          "consumer": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "repository",
              "sha",
              "tree"
            ],
            "properties": {
              "repository": {
                "type": "string",
                "minLength": 3
              },
              "sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "tree": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "framework": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_sha",
              "source_tree",
              "target_sha",
              "target_tree"
            ],
            "properties": {
              "source_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "source_tree": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "target_sha": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "target_tree": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              }
            }
          },
          "transitions": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "adoption",
              "upgrade_b",
              "rollback_a",
              "retry_b"
            ],
            "properties": {
              "adoption": {
                "const": "COMMITTED"
              },
              "upgrade_b": {
                "const": "COMMITTED"
              },
              "rollback_a": {
                "const": "ROLLED_BACK"
              },
              "retry_b": {
                "const": "COMMITTED"
              }
            }
          },
          "external_source_unchanged": {
            "const": true
          },
          "write_back_performed": {
            "const": false
          },
          "certification_sha256": {
            "type": "string",
            "format": "sha256"
          }
        }
      }
    },
    "registry_sha256": {
      "type": "string",
      "format": "sha256"
    }
  }
}
