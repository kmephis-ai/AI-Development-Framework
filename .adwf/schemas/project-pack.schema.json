              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "requires_file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "phases": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "bootstrap",
                  "pr",
                  "main",
                  "runtime"
                ]
              }
            }
          }
        },
        "start": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "command",
            "phases"
          ],
          "properties": {
            "command": {
              "type": "array",
              "maxItems": 32,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            },
            "requires_script": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9_.:-]+$"
            },
            "requires_file": {
              "type": "string",
              "minLength": 1,
              "maxLength": 160
            },
            "phases": {
              "type": "array",
              "minItems": 1,
              "maxItems": 4,
              "uniqueItems": true,
              "items": {
                "enum": [
                  "bootstrap",
                  "pr",
                  "main",
                  "runtime"
                ]
              }
            }
          }
        }
      }
    },
    "preview": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "desktop": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "mobile": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "golden_paths": {
          "type": "array",
          "maxItems": 32,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          }
        },
        "default_url": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "health_path": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "monetary_budget_usd",
        "secrets",
        "network",
        "environment",
        "data_access"
      ],
      "properties": {
        "monetary_budget_usd": {
          "const": 0
        },
        "secrets": {
          "const": "FORBIDDEN"
        },
        "network": {
          "enum": [
            "NONE",
            "LOOPBACK",
            "PACKAGE_REGISTRY",
            "PACKAGE_REGISTRY_AND_LOOPBACK"
          ]
        },
        "environment": {
          "const": "PROCESS_MINIMAL"
        },
        "data_access": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "read_scope",
            "write_scope"
          ],
          "properties": {
            "read_scope": {
              "const": "PROJECT_TREE"
            },
            "write_scope": {
              "const": "TOOL_OUTPUTS_ONLY"
            }
          }
        }
      }
    }
  }
}
