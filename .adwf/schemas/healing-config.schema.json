{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF Safe Healing configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema", "schema_version", "enabled", "mandatory_ai_api", "monetary_budget", "allow_network", "automatic_rollback_certified", "budgets", "transient_failure_types", "deterministic_failure_types", "protected_paths"],
  "properties": {
    "$schema": {"type": "string"},
    "schema_version": {"const": 1},
    "enabled": {"const": true},
    "mandatory_ai_api": {"const": false},
    "monetary_budget": {"const": 0},
    "allow_network": {"const": false},
    "automatic_rollback_certified": {"type": "boolean"},
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_attempts", "max_elapsed_seconds", "max_actions", "max_changed_files", "max_false_heals"],
      "properties": {
        "max_attempts": {"type": "integer", "minimum": 1, "maximum": 3},
        "max_elapsed_seconds": {"type": "integer", "minimum": 30, "maximum": 3600},
        "max_actions": {"type": "integer", "minimum": 1, "maximum": 10},
        "max_changed_files": {"type": "integer", "minimum": 1, "maximum": 50},
        "max_false_heals": {"const": 1}
      }
    },
    "transient_failure_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
    "deterministic_failure_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]+$"}},
    "protected_paths": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string", "minLength": 3}}
  }
}
