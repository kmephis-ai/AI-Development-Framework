{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF append-only evidence event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "sequence", "previous_event_sha256", "event_sha256",
    "id", "kind", "status", "subject", "sha", "source", "source_type",
    "command", "runner", "created_at", "expires_at", "content_sha256",
    "artifact", "runtime_revision", "product_impact", "provenance"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "previous_event_sha256": {"type": ["string", "null"], "format": "sha256"},
    "event_sha256": {"type": "string", "format": "sha256"},
    "id": {"type": "string", "minLength": 8},
    "kind": {"enum": ["CI", "REVIEW", "SMOKE", "GOLDEN_PATHS", "E2E", "REALITY", "QCP", "ACP", "ADWF_SELF_AUDIT", "RELEASE", "INCIDENT", "REPAIR"]},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_VERIFIED", "STALE", "N/A"]},
    "subject": {"type": "string", "minLength": 1},
    "sha": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "source": {"type": "string", "minLength": 1},
    "source_type": {"enum": ["LOCAL", "GITHUB_ACTIONS", "GITLAB_CI", "RUNTIME", "HUMAN_ATTESTATION"]},
    "command": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "runner": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "content_sha256": {"type": "string", "format": "sha256"},
    "artifact": {"type": ["string", "null"]},
    "runtime_revision": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
    "product_impact": {"type": "boolean"},
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provider", "source_identity", "trust_domain", "repository", "workflow", "invocation_id"],
      "properties": {
        "provider": {"enum": ["local", "github", "gitlab"]},
        "source_identity": {"type": "string", "minLength": 1},
        "trust_domain": {"type": "string", "minLength": 1},
        "repository": {"type": "string", "minLength": 1},
        "workflow": {"type": "string", "minLength": 1},
        "invocation_id": {"type": "string", "minLength": 1}
      }
    }
  }
}
