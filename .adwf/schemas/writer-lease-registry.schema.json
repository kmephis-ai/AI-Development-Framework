{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ADWF provider-durable writer lease registry v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "repository",
    "revision",
    "observed_main_sha",
    "max_parallel_writers",
    "leases",
    "integrity_digest"
  ],
  "properties": {
    "$schema": {
      "const": ".adwf/schemas/writer-lease-registry.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "repository": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "observed_main_sha": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "max_parallel_writers": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3
    },
    "leases": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lease_id",
          "generation",
          "issue_id",
          "roadmap_id",
          "worker_id",
          "base_sha",
          "branch",
          "resources",
          "status",
          "claimed_at",
          "heartbeat_at",
          "expires_at",
          "released_at",
          "provider_reconciled_at",
          "provider_reconciliation_ref"
        ],
        "properties": {
          "lease_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "generation": {
            "type": "integer",
            "minimum": 1
          },
          "issue_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[0-9]+$"
          },
          "roadmap_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Z][A-Z0-9_]*-[0-9]+$"
          },
          "worker_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9_.:@+\\-/#]+$"
          },
          "base_sha": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "branch": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._/+\\-]*$"
          },
          "resources": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "kind",
                "scope",
                "shared",
                "global"
              ],
              "properties": {
                "kind": {
                  "enum": [
                    "source",
                    "projection",
                    "runtime",
                    "data",
                    "provider",
                    "release",
                    "governance"
                  ]
                },
                "scope": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 240,
                  "pattern": "^[A-Za-z0-9_.:@+\\-]+(?:/[A-Za-z0-9_.:@+\\-]+)*$"
                },
                "shared": {
                  "type": "boolean"
                },
                "global": {
                  "type": "boolean"
                }
              }
            }
          },
          "status": {
            "enum": [
              "ACTIVE",
              "RELEASED"
            ]
          },
          "claimed_at": {
            "type": "string",
            "format": "date-time"
          },
          "heartbeat_at": {
            "type": "string",
            "format": "date-time"
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "released_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "provider_reconciled_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "provider_reconciliation_ref": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 500,
            "pattern": "^[A-Za-z0-9_.:@+\\-/#]+$"
          }
        }
      }
    },
    "integrity_digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  }
}
