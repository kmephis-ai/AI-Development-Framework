{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["$schema","schema_version","role","status","consumer","framework","pack","profile","upgrade","transitions","preservation_set_sha256","preservation_checkpoints","provider","external_source_unchanged","write_back_performed","report_sha256"],
  "properties": {
    "$schema": {"const": ".adwf/schemas/external-consumer-upgrade-proof.schema.json"},
    "schema_version": {"const": 1},
    "role": {"const": "EXTERNAL_CONSUMER_UPGRADE_PROOF"},
    "status": {"const": "PASS"},
    "consumer": {"type":"object","additionalProperties":false,"required":["repository","sha","tree","tracked_regular_file_count"],"properties":{"repository":{"type":"string","minLength":3},"sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},"tracked_regular_file_count":{"type":"integer","minimum":1}}},
    "framework": {"type":"object","additionalProperties":false,"required":["source_sha","source_tree","target_sha","target_tree"],"properties":{"source_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"source_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"},"target_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"target_tree":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},
    "pack": {"type":"object","additionalProperties":false,"required":["id","source_digest","target_digest"],"properties":{"id":{"const":"apps-script"},"source_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"},"target_digest":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "profile": {"type":"object","additionalProperties":false,"required":["source_sha256","target_sha256"],"properties":{"source_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"target_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "upgrade": {"type":"object","additionalProperties":false,"required":["compatibility_sha256","plan_sha256","transaction_id","retry_transaction_id"],"properties":{"compatibility_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"plan_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"transaction_id":{"type":"string","minLength":8},"retry_transaction_id":{"type":"string","minLength":8}}},
    "transitions": {"type":"object","additionalProperties":false,"required":["adoption","upgrade_b","rollback_a","retry_b"],"properties":{"adoption":{"enum":["COMMITTED","VERIFIED_EXISTING"]},"upgrade_b":{"const":"COMMITTED"},"rollback_a":{"const":"ROLLED_BACK"},"retry_b":{"const":"COMMITTED"}}},
    "preservation_set_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"},
    "preservation_checkpoints": {"type":"array","minItems":4,"maxItems":4,"items":{"type":"object","additionalProperties":false,"required":["label","file_count","preservation_sha256"],"properties":{"label":{"enum":["ADOPTION_A","CONNECTED_A","UPGRADE_B","ROLLBACK_A","RETRY_B"]},"file_count":{"type":"integer","minimum":1},"preservation_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}}},
    "provider": {"type":"object","additionalProperties":false,"required":["run_id","check"],"properties":{"run_id":{"type":"string","minLength":1},"check":{"const":"adwf/external-consumer-upgrade-proof"}}},
    "external_source_unchanged": {"const": true},
    "write_back_performed": {"const": false},
    "report_sha256": {"type":"string","pattern":"^[0-9a-f]{64}$"}
  }
}
