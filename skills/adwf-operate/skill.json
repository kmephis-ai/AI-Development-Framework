{
  "schema_version": 1,
  "id": "adwf-operate",
  "kind": "router",
  "lifecycle": "ACTIVE",
  "origin": {
    "kind": "first_party"
  },
  "description": "Router ADWF для release, incident, upgrade, rollback, cost и runtime operations с минимальной загрузкой leaf Skills и FREE_ONLY boundary.",
  "entrypoint": "SKILL.md",
  "routing": {
    "startup_visible": true,
    "routed_by": [],
    "routes": [
      "adwf-local-git-mirror"
    ],
    "trigger_terms": [
      "release",
      "incident",
      "upgrade",
      "rollback",
      "cost",
      "runtime operation"
    ],
    "negative_terms": [
      "только аудит",
      "pure code implementation"
    ]
  },
  "effects": {
    "shell": false,
    "filesystem": "none",
    "network": "none",
    "secrets": "none"
  },
  "external_domains": [],
  "dependencies": [],
  "evals": {
    "trigger_positive": "evals/trigger-positive.json",
    "trigger_negative": "evals/trigger-negative.json",
    "success_cases": "evals/success-cases.json",
    "adversarial": "evals/adversarial.json"
  },
  "quality": {
    "min_no_trigger_precision": 1.0
  },
  "context_budget": {
    "max_description_chars": 320,
    "max_skill_md_chars": 12000
  }
}
